# Appwrite Cloud Configuration
# Copy this file to .env.local and fill in your actual values

# Appwrite Cloud API Endpoint (update with your region: sfo, fra, blr, syd, etc.)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1

# Your Appwrite Project ID (get from https://cloud.appwrite.io)
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Your Appwrite Database ID (get from Database settings in Appwrite Console)
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your-database-id

# Local server API key (seed scripts and `npm run dev`).
# On an Appwrite Site, server routes prefer the ephemeral key on the
# `x-appwrite-key` request header and use this value only as a fallback.
# Get from Project Settings > API Keys tab.
# Scopes needed: Database (documents.read, documents.write)
# WARNING: Never commit a real key.
APPWRITE_API_KEY=

# Optional support link. Create a Stripe Payment Link with
# "Let customers choose what to pay", suggested $3, minimum $1,
# then set STRIPE_SUPPORT_LINK to that Payment Link URL.
# Next.js only exposes public variables to the browser, so the
# variable name includes the NEXT_PUBLIC_ prefix. Leave this unset
# or empty to hide the footer link. No Stripe secret key is used.
# Placeholder: https://buy.stripe.com/your-payment-link
NEXT_PUBLIC_STRIPE_SUPPORT_LINK=

# Setup Instructions:
# 1. Sign up at https://cloud.appwrite.io
# 2. Create a new project named "bible-study-tool"
# 3. Copy your Project ID from the dashboard
# 4. Paste it above in NEXT_PUBLIC_APPWRITE_PROJECT_ID
# 5. Create database "bible_study" with collections: notes, graph_nodes, graph_edges, themes
# 6. See Deployment_Alternatives.md for detailed setup guide
